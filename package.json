{
  "name": "team-task-tracker",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "pnpm --filter backend run prisma:generate",
    "dev": "pnpm --filter @team-task-tracker/shared run build && pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:tooling": "node --test \"scripts/**/*.test.mjs\"",
    "spec:validate": "node scripts/spec-validate.mjs",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "check:changes": "node scripts/check-changes.mjs",
    "test:e2e": "pnpm --filter e2e run test:e2e",
    "perf:lighthouse": "node scripts/lighthouse.mjs",
    "db:up": "docker compose --profile dev up -d --wait",
    "db:down": "docker compose --profile dev down"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.15.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lighthouse": "13.6.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
