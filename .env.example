# Copy to .env at the repository root. Never commit .env.
# These values are for local containers only (docker-compose.yml) and are not secrets.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Dev database (db-dev, port 5432). Integration tests use port 5433 / tasktracker_test.
# E2E uses port 5433 / tasktracker_e2e. A git worktree should use its own database name.
DATABASE_URL=postgresql://tasktracker:tasktracker_dev_only@localhost:5432/tasktracker_dev

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-bytes-aaaa

# Origin allowed by the Origin check on /auth/refresh and /auth/logout.
APP_ORIGIN=http://localhost:5173
# true in production only (Secure cookie).
COOKIE_SECURE=false

# Docker full profile (`docker compose --profile full up --build`): the backend container reads
# JWT_ACCESS_SECRET from this file. Optional overrides:
# DOCKER_DB_PASSWORD=...          (default tasktracker_docker_only; the database is not published)
# DOCKER_APP_ORIGIN=http://localhost:8080
# (the full profile always sets API_DOCS_ENABLED=true; Swagger UI is at http://localhost:8080/api/docs)

# Swagger UI at /api/docs and the raw spec at /api/docs/openapi.json. Unset means true in
# development and test, false in production.
API_DOCS_ENABLED=true
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# Frontend dev server proxy target.
VITE_API_PROXY_TARGET=http://localhost:3000
